# Скопируйте этот файл в .env и впишите свои значения.
# Файл .env никогда не попадёт в git — он в .gitignore.

# Ключ от Auto.dev (тариф Starter). Взять на https://www.auto.dev/
AUTO_DEV_API_KEY=

# Токен бота из @BotFather в Telegram
TELEGRAM_BOT_TOKEN=

# ID чата, куда присылать машины (см. README — как узнать свой chat_id)
TELEGRAM_CHAT_ID=

# Тестовый режим: true = присылать всего 3 машины (для первой проверки).
# Когда убедитесь, что всё работает как нужно — поставьте false.
TEST_MODE=true
MAX_TEST_CARS=3

# Сколько машин максимум присылать за один обычный (не тестовый) прогон в день.
MAX_CARS_PER_RUN=15

# Защита от перерасхода лимита Auto.dev (1000 запросов/месяц на Starter).
# Один прогон = один поиск, максимум столько страниц пагинации.
MAX_API_PAGES=10

# Параметры поиска — можно менять, если нужно
SEARCH_ZIP=33069
SEARCH_DISTANCE=50
SEARCH_YEAR_MIN=2019
SEARCH_MILEAGE_MAX=85000
SEARCH_PRICE_MAX=50000
